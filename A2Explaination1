        "#Manual bit of the tracker\n",
        "#This part allows the user to manually input their finances like we did in class\n",
        "#It also loops until the user says done\n",
        "\n",
        "def manual_input():\n",
        "    \"\"\"Allow the user to manually enter transactions.\"\"\"\n",
        "    transactions = []\n",
        "    print(\"\\nMANUAL FINANCE INPUT\")\n",
        "    print(\"-\" * 40)\n",
        "    #The loop\n",
        "    while True:\n",
        "        transaction_type = input(\n",
        "            \"\\nIs this Income or Expense? \"\n",
        "            \"(or type 'done' or 'finish' to finish): \").strip().lower()\n",
        "        if transaction_type in [\"done\", \"finish\"]:\n",
        "            print(\"\\nFinished entering transactions.\" )\n",
        "            break\n",
        "        transaction_type = transaction_type.title()\n",
        "        while transaction_type not in [\n",
        "            \"Income\",\n",
        "            \"Expense\"]:\n",
        "            print(\n",
        "                \"Please enter either \"\n",
        "                \"'Income' or 'Expense'.\")\n",
        "            transaction_type = input(\n",
        "                \"Is this Income or Expense? \"\n",
        "            ).strip().lower()\n",
        "            if transaction_type in [\n",
        "                \"done\",\n",
        "                \"finish\"]:\n",
        "                print(\"\\nFinished entering transactions.\")\n",
        "                return pd.DataFrame(\n",
        "                    transactions)\n",
        "            transaction_type = (\n",
        "                transaction_type.title())\n",
        "        while True:\n",
        "            try:\n",
        "                amount = float(\n",
        "                    input(\"Enter the amount: $\")\n",
        "                )\n",
        "                if amount <= 0:\n",
        "                    print(\n",
        "                        \"Please enter a \"\n",
        "                        \"positive amount.\")\n",
        "                    continue\n",
        "                break\n",
        "            except ValueError:\n",
        "                print(\"Please enter a valid number.\")\n",
        "        category = input(\"Enter the category: \").strip()\n",
        "        description = input(\"Enter a description: \").strip()\n",
        "        transactions.append({\n",
        "            \"Date\": datetime.now().strftime(\n",
        "                \"%Y-%m-%d\"),\n",
        "            \"Category\": category,\n",
        "            \"Description\": description,\n",
        "            \"Type\": transaction_type,\n",
        "            \"Amount\": amount})\n",
        "        print(\"\\nTransaction added successfully!\")\n",
        "    df = pd.DataFrame(transactions)\n",
        "    return df"
      ],
