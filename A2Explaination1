    {
      "cell_type": "code",
      "source": [
        "#CSV option\n",
        "#This segment allows the user to import their CSV file and it tells the user what colums their missing\n",
        "#It won't accept CSV files missing Date, Category, Description, Type and Amount\n",
        "#If so, the code will tell the user what's missing.\n",
        "#It also lets the user know if the file couldn't be read\n",
        "\n",
        "def upload_csv():\n",
        "  \"\"\"Allow user to upload CSV.\"\"\"\n",
        "  print(\"\\nPlease select a CSV file. \")\n",
        "  uploaded = files.upload()\n",
        "  filename = next(iter(uploaded))\n",
        "  encodings = [\"utf-8\", \"cp1252\", \"latin1\"]\n",
        "  df = None\n",
        "  for encoding in encodings:\n",
        "    try:\n",
        "      df = pd.read_csv(filename, encoding=encoding)\n",
        "      print(f\"\\nFile read\" f\"using {encoding} encoding.\")\n",
        "      break\n",
        "    except UnicodeDecodeError:\n",
        "      continue\n",
        "  if df is None:\n",
        "      print(\"\\nError: CSV could not be read. \")\n",
        "      return None\n",
        "  required_columns = [\"Date\", \"Category\", \"Description\", \"Type\", \"Amount\"]\n",
        "  if not all(column in df.columns for column in required_columns):\n",
        "      print(\"\\nError: CSV is missing required columns. \")\n",
        "      return None\n",
        "  df = df[required_columns].copy()\n",
        "\n",
        "#This segment is what actually checks the data is correct from the file the user imports\n",
        "#I asked chat gpt to check the code and tell me what was wrong when I orignally wrote it\n",
        "#Mistake 1: It was on the wrong line/not within the def upload\n",
        "#Mistake 2: ALOT of the brackets were messed up because I had lost track of some.\n",
        "\n",
        "  df[\"Amount\"] = (df[\"Amount\"].astype(str).str.replace(\"$\",\"\", regex=False).str.replace(\",\",\"\", regex=False).str.strip())\n",
        "  df[\"Amount\"] = pd.to_numeric(df[\"Amount\"], errors=\"coerce\")\n",
        "  df[\"Date\"] = pd.to_datetime(df[\"Date\"], errors=\"coerce\")\n",
        "  df[\"Type\"] = (df[\"Type\"].astype(str).str.strip().str.title())\n",
        "  df[\"Category\"] = (df[\"Category\"].astype(str).str.strip())\n",
        "  df = df.dropna(subset=[\"Date\", \"Amount\"])\n",
        "  df = df[df[\"Type\"].isin([\"Income\", \"Expense\"])]\n",
        "  df = df[df[\"Amount\"] > 0]\n",
        "  return df"
      ],
