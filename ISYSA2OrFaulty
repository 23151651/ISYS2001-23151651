    {
      "cell_type": "code",
      "source": [
        "# ==========================================\n",
        "# PERSONAL FINANCE TRACKER\n",
        "# ==========================================\n",
        "\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "from datetime import datetime\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# Generate Timestamp bit\n",
        "# ==========================================\n",
        "\n",
        "def generate_timestamp():\n",
        "    \"\"\"Generate the current date and time.\"\"\"\n",
        "    return datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# CSV IMPORT\n",
        "# ==========================================\n",
        "\n",
        "def upload_csv():\n",
        "    \"\"\"Allow the user to upload a CSV file.\"\"\"\n",
        "\n",
        "    print(\"\\nPlease choose your CSV file.\")\n",
        "\n",
        "    uploaded = files.upload()\n",
        "\n",
        "    filename = next(iter(uploaded))\n",
        "\n",
        "    # Try multiple encodings\n",
        "    encodings = [\"utf-8\", \"cp1252\", \"latin1\"]\n",
        "\n",
        "    df = None\n",
        "\n",
        "    for encoding in encodings:\n",
        "\n",
        "        try:\n",
        "            df = pd.read_csv(\n",
        "                filename,\n",
        "                encoding=encoding\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"\\nFile successfully read \"\n",
        "                f\"using {encoding} encoding.\"\n",
        "            )\n",
        "\n",
        "            break\n",
        "\n",
        "        except UnicodeDecodeError:\n",
        "            continue\n",
        "\n",
        "        except pd.errors.ParserError:\n",
        "            continue\n",
        "\n",
        "    # Check whether the CSV could be read\n",
        "    if df is None:\n",
        "\n",
        "        print(\"\\nERROR: Could not read the CSV file.\")\n",
        "\n",
        "        return None\n",
        "\n",
        "    # Required columns\n",
        "    required_columns = [\n",
        "        \"Date\",\n",
        "        \"Category\",\n",
        "        \"Description\",\n",
        "        \"Type\",\n",
        "        \"Amount\"\n",
        "    ]\n",
        "\n",
        "    # Check columns\n",
        "    if not all(\n",
        "        column in df.columns\n",
        "        for column in required_columns\n",
        "    ):\n",
        "\n",
        "        print(\"\\nERROR: Your CSV is missing columns.\")\n",
        "\n",
        "        print(\"\\nRequired columns:\")\n",
        "        print(required_columns)\n",
        "\n",
        "        print(\"\\nColumns found:\")\n",
        "        print(list(df.columns))\n",
        "\n",
        "        return None\n",
        "\n",
        "    # Keep required columns\n",
        "    df = df[required_columns].copy()\n",
        "\n",
        "    # Clean Amount\n",
        "    df[\"Amount\"] = (\n",
        "        df[\"Amount\"]\n",
        "        .astype(str)\n",
        "        .str.replace(\"$\", \"\", regex=False)\n",
        "        .str.replace(\",\", \"\", regex=False)\n",
        "        .str.strip()\n",
        "    )\n",
        "\n",
        "    df[\"Amount\"] = pd.to_numeric(\n",
        "        df[\"Amount\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    # Clean Date\n",
        "    df[\"Date\"] = pd.to_datetime(\n",
        "        df[\"Date\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    # Clean Type\n",
        "    df[\"Type\"] = (\n",
        "        df[\"Type\"]\n",
        "        .astype(str)\n",
        "        .str.strip()\n",
        "        .str.title()\n",
        "    )\n",
        "\n",
        "    # Clean Category\n",
        "    df[\"Category\"] = (\n",
        "        df[\"Category\"]\n",
        "        .astype(str)\n",
        "        .str.strip()\n",
        "    )\n",
        "\n",
        "    # Remove invalid rows\n",
        "    df = df.dropna(\n",
        "        subset=[\"Date\", \"Amount\"]\n",
        "    )\n",
        "\n",
        "    df = df[\n",
        "        df[\"Type\"].isin(\n",
        "            [\"Income\", \"Expense\"]\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    df = df[\n",
        "        df[\"Amount\"] > 0\n",
        "    ]\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# MANUAL INPUT\n",
        "# ==========================================\n",
        "\n",
        "def manual_input():\n",
        "    \"\"\"Allow the user to manually enter transactions.\"\"\"\n",
        "\n",
        "    transactions = []\n",
        "\n",
        "    print(\"\\nMANUAL FINANCE INPUT\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    while True:\n",
        "\n",
        "        category = input(\n",
        "            \"\\nEnter the category \"\n",
        "            \"(or type 'done' to finish): \"\n",
        "        )\n",
        "\n",
        "        if category.lower() == \"done\":\n",
        "            break\n",
        "\n",
        "        description = input(\n",
        "            \"Enter a description: \"\n",
        "        )\n",
        "\n",
        "        transaction_type = input(\n",
        "            \"Is this Income or Expense? \"\n",
        "        ).strip().title()\n",
        "\n",
        "        # Validate transaction type\n",
        "        while transaction_type not in [\n",
        "            \"Income\",\n",
        "            \"Expense\"\n",
        "        ]:\n",
        "\n",
        "            print(\"Please enter either \"\n",
        "                \"'Income' or 'Expense'.\")\n",
        "\n",
        "            transaction_type = input(\n",
        "                \"Is this Income or Expense? \"\n",
        "            ).strip().title()\n",
        "\n",
        "        # Get amount\n",
        "        while True:\n",
        "\n",
        "            try:\n",
        "\n",
        "                amount = float(\n",
        "                    input(\"Enter the amount: $\")\n",
        "                )\n",
        "\n",
        "                if amount <= 0:\n",
        "                    print(\n",
        "                        \"Please enter a \"\n",
        "                        \"positive amount.\"\n",
        "                    )\n",
        "                    continue\n",
        "\n",
        "                break\n",
        "\n",
        "            except ValueError:\n",
        "\n",
        "                print(\n",
        "                    \"Please enter a valid number.\"\n",
        "                )\n",
        "\n",
        "        # Add transaction\n",
        "        transactions.append({\n",
        "            \"Date\": datetime.now().strftime(\n",
        "                \"%Y-%m-%d\"\n",
        "            ),\n",
        "            \"Category\": category,\n",
        "            \"Description\": description,\n",
        "            \"Type\": transaction_type,\n",
        "            \"Amount\": amount\n",
        "        })\n",
        "\n",
        "    # Create DataFrame\n",
        "    df = pd.DataFrame(transactions)\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# FINANCE ANALYSIS\n",
        "# ==========================================\n",
        "\n",
        "def display_finance_analysis(df):\n",
        "    \"\"\"Calculate and display financial information.\"\"\"\n",
        "\n",
        "    if df.empty:\n",
        "\n",
        "        print(\"\\nNo transactions were entered.\")\n",
        "\n",
        "        return\n",
        "\n",
        "    # Calculate income\n",
        "    income = df.loc[\n",
        "        df[\"Type\"] == \"Income\",\n",
        "        \"Amount\"\n",
        "    ].sum()\n",
        "\n",
        "    # Calculate expenses\n",
        "    expenses = df.loc[\n",
        "        df[\"Type\"] == \"Expense\",\n",
        "        \"Amount\"\n",
        "    ].sum()\n",
        "\n",
        "    # Calculate balance\n",
        "    balance = income - expenses\n",
        "\n",
        "    # ======================================\n",
        "    # TRANSACTION HISTORY\n",
        "    # ======================================\n",
        "\n",
        "    print(\"\\nTRANSACTION HISTORY\")\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "    print(\n",
        "        df.to_string(index=False)\n",
        "    )\n",
        "\n",
        "    # ======================================\n",
        "    # FINANCIAL SUMMARY\n",
        "    # ======================================\n",
        "\n",
        "    print(\"\\nFINANCIAL SUMMARY\")\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "    print(\n",
        "        f\"Total Income:      ${income:,.2f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Total Expenses:    ${expenses:,.2f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Remaining Balance: ${balance:,.2f}\"\n",
        "    )\n",
        "\n",
        "    # ======================================\n",
        "    # SPENDING BY CATEGORY\n",
        "    # ======================================\n",
        "\n",
        "    print(\"\\nSPENDING BY CATEGORY\")\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "    spending = df[\n",
        "        df[\"Type\"] == \"Expense\"\n",
        "    ]\n",
        "\n",
        "    category_totals = (\n",
        "        spending\n",
        "        .groupby(\"Category\")[\"Amount\"]\n",
        "        .sum()\n",
        "        .sort_values(\n",
        "            ascending=False\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if category_totals.empty:\n",
        "\n",
        "        print(\"No expenses recorded.\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        for category, amount in (\n",
        "            category_totals.items()\n",
        "        ):\n",
        "\n",
        "            if expenses > 0:\n",
        "\n",
        "                percentage = (\n",
        "                    amount / expenses\n",
        "                ) * 100\n",
        "\n",
        "            else:\n",
        "\n",
        "                percentage = 0\n",
        "\n",
        "            print(\n",
        "                f\"{category}: \"\n",
        "                f\"${amount:,.2f} \"\n",
        "                f\"({percentage:.1f}%)\"\n",
        "            )\n",
        "\n",
        "    # ======================================\n",
        "    # FINANCIAL STATUS\n",
        "    # ======================================\n",
        "\n",
        "    print(\"\\nFINANCIAL STATUS\")\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "    if balance > 0:\n",
        "\n",
        "        print(\"You're gaining money, woohoo!.\")\n",
        "\n",
        "    elif balance == 0:\n",
        "\n",
        "        print(\"Your income and expenses are balanced.\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"Your expenses exceed your income.\")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# MAIN PROGRAM\n",
        "# ==========================================\n",
        "\n",
        "def main():\n",
        "    \"\"\"Main program.\"\"\"\n",
        "\n",
        "    print(\"=\" * 60)\n",
        "    print(\"              PERSONAL FINANCE TRACKER\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    # Timestamp\n",
        "    timestamp = generate_timestamp()\n",
        "\n",
        "    print(\n",
        "        f\"Begin Session: {timestamp}\"\n",
        "    )\n",
        "\n",
        "    print()\n",
        "\n",
        "    # Ask user's name\n",
        "    name = input(\"What's your name? \")\n",
        "\n",
        "    print(f\"\\nWelcome to your Personal Finance tracker, {name}!\")\n",
        "    print(f\"\\nWe are so glad to have you! \")\n",
        "\n",
        "    # Ask whether to use CSV\n",
        "    while True:\n",
        "\n",
        "        csv_choice = input(\n",
        "            \"\\nWould you like to import \"\n",
        "            \"your finances from a CSV file? \"\n",
        "            \"(yes/no): \"\n",
        "        ).strip().lower()\n",
        "\n",
        "        if csv_choice in [\"yes\", \"no\"]:\n",
        "            break\n",
        "\n",
        "        print(\"Please enter 'yes' or 'no'.\")\n",
        "\n",
        "    # ======================================\n",
        "    # CSV OPTION\n",
        "    # ======================================\n",
        "\n",
        "    if csv_choice == \"yes\":\n",
        "\n",
        "        df = upload_csv()\n",
        "\n",
        "        # Stop if upload failed\n",
        "        if df is None:\n",
        "\n",
        "            print(\"\\nThe CSV could not be imported.\")\n",
        "\n",
        "            return\n",
        "\n",
        "    # ======================================\n",
        "    # MANUAL OPTION\n",
        "    # ======================================\n",
        "\n",
        "    else:\n",
        "\n",
        "        df = manual_input()\n",
        "\n",
        "    # ======================================\n",
        "    # ANALYSE DATA\n",
        "    # ======================================\n",
        "\n",
        "    display_finance_analysis(df)\n",
        "\n",
        "    # ======================================\n",
        "    # SAVE CLEANED DATA\n",
        "    # ======================================\n",
        "\n",
        "    save_choice = input(\n",
        "        \"\\nWould you like to save your \"\n",
        "        \"transactions as a CSV file? \"\n",
        "        \"(yes/no): \"\n",
        "    ).strip().lower()\n",
        "\n",
        "    if save_choice == \"yes\":\n",
        "\n",
        "        output_file = (\n",
        "            \"cleaned_finances.csv\"\n",
        "        )\n",
        "\n",
        "        df.to_csv(\n",
        "            output_file,\n",
        "            index=False\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"\\nYour file has been saved \"\n",
        "            f\"as {output_file}.\"\n",
        "        )\n",
        "\n",
        "        files.download(\n",
        "            output_file\n",
        "        )\n",
        "\n",
        "    print(\n",
        "        \"\\nThank you for using the \"\n",
        "        \"Personal Finance Tracker!\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# RUN PROGRAM\n",
        "# ==========================================\n",
        "\n",
        "main()"
      ],
