        "\n",
        "# Raw transaction data\n",
        "transactions = [\n",
        "    {\"category\": \"Food\", \"amount\": 15.50},\n",
        "    {\"category\": \"Transport\", \"amount\": 8.00},\n",
        "    {\"category\": \"Food\", \"amount\": 22.30},\n",
        "    {\"category\": \"Entertainment\", \"amount\": 18.00},\n",
        "    {\"category\": \"Transport\", \"amount\": 12.50},\n",
        "    {\"category\": \"Shopping\", \"amount\": 45.00}\n",
        "]\n",
        "\n",
        "# Build the spending dictionary\n",
        "\n",
        "spending = {}\n",
        "\n",
        "for transaction in transactions:\n",
        "    category = transaction[\"category\"]\n",
        "\n",
        "    # Create the category if it does not already exist\n",
        "    if category not in spending:\n",
        "        spending[category] = []\n",
        "\n",
        "    # Add the transaction amount to that category\n",
        "    spending[category].append(transaction[\"amount\"])\n",
        "\n",
        "\n",
        "# Function 1: Find the total spent in one category\n",
        "\n",
        "def total_for(spending, category):\n",
        "    # Return 0 if the category does not exist\n",
        "    if category not in spending:\n",
        "        return 0\n",
        "\n",
        "    # Add all amounts in the category\n",
        "    total = 0\n",
        "\n",
        "    for amount in spending[category]:\n",
        "        total += amount\n",
        "\n",
        "    return total\n",
        "\n",
        "# Function 2: Add a new transaction\n",
        "\n",
        "\n",
        "def add_transaction(spending, transaction):\n",
        "    category = transaction[\"category\"]\n",
        "    amount = transaction[\"amount\"]\n",
        "\n",
        "    # Create the category if needed\n",
        "    if category not in spending:\n",
        "        spending[category] = []\n",
        "\n",
        "    # Add the new amount\n",
        "    spending[category].append(amount)\n",
        "\n",
        "\n",
        "# Function 3: Create a summary of every category\n",
        "\n",
        "def summary(spending):\n",
        "    totals = {}\n",
        "\n",
        "    for category in spending:\n",
        "        totals[category] = total_for(spending, category)\n",
        "\n",
        "    return totals\n",
